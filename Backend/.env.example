PORT=5000

# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Configuration (Supabase PostgreSQL)
DB_HOST=your-db-host.supabase.com
DB_PORT=6543
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-db-password
DB_NAME=postgres
DB_SSL=true

# Services
PYTHON_SERVICE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
OPTIMIZER_PYTHON=/path/to/your/.venv/Scripts/python.exe
# Override GA script path (optional — defaults to ../../../../GeneticAlgorithm/optimizer_sched.py relative to gaController.js)
OPTIMIZER_SCHED_PATH=/absolute/path/to/GeneticAlgorithm/optimizer_sched.py
